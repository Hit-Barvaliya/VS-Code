

import pandas as pd
import numpy as np

df = pd.read_csv(r"D:\Programming\Code\Python\bank_marketing.csv")

print("First 5 Records:")
print(df.head())

print("\nDataset Shape (Rows, Columns):")
print(df.shape)

print("\nColumn Names and Data Types:")
print(df.dtypes)

print("\nDuplicate Records Count:")
print(df.duplicated().sum())

df = df.drop_duplicates()

print("\nShape After Removing Duplicates:")
print(df.shape)

identifier_attributes = []

numerical_attributes = df.select_dtypes(include=["int64", "float64"]).columns.tolist()

categorical_attributes = df.select_dtypes(include=["object"]).columns.tolist()

print("\nIdentifier Attributes:")
print(identifier_attributes)

print("\nNumerical Attributes:")
print(numerical_attributes)

print("\nCategorical Attributes:")
print(categorical_attributes)

ordinal_attributes = ["education", "month"]

nominal_attributes = list(set(categorical_attributes) - set(ordinal_attributes))

print("\nOrdinal Categorical Attributes:")
print(ordinal_attributes)

print("\nNominal Categorical Attributes:")
print(nominal_attributes)

df.replace("unknown", np.nan, inplace=True)


print("\nMissing Values Per Column:")
print(df.isnull().sum())

for col in categorical_attributes:
    if df[col].isnull().sum() > 0:
        df[col].fillna(df[col].mode()[0], inplace=True)

for col in numerical_attributes:
    if df[col].isnull().sum() > 0:
        df[col].fillna(df[col].median(), inplace=True)

print("\nMissing Values After Imputation:")
print(df.isnull().sum())


df["y"] = df["y"].map({"yes": 1, "no": 0})


education_order = {
    "primary": 1,
    "secondary": 2,
    "tertiary": 3
}
df["education"] = df["education"].map(education_order)

month_order = {
    "jan": 1, "feb": 2, "mar": 3, "apr": 4,
    "may": 5, "jun": 6, "jul": 7, "aug": 8,
    "sep": 9, "oct": 10, "nov": 11, "dec": 12
}
df["month"] = df["month"].map(month_order)



df = pd.get_dummies(df, columns=nominal_attributes, drop_first=True)

df["pdays"] = df["pdays"].replace(-1, 0)


print("\nFinal Cleaned Dataset Info:")
print(df.info())

print("\nFinal Dataset Shape:")
print(df.shape)

print("\nFinal Dataset Preview:")
print(df.head())
